{
  "name":"scenic-planner","version":"1.4.0","description":"Offline scene, shot and lighting planning","author":"Squid Productions","license":"MIT","private":true,"main":"main.cjs",
  "scripts":{"dist":"electron-builder --win nsis --x64 --publish never"},
  "dependencies":{"electron-updater":"6.8.9"},
  "devDependencies":{"electron":"44.7.0","electron-builder":"26.15.3"},
  "build":{
    "appId":"org.squidproductions.scenic","productName":"Scenic",
    "directories":{"output":"../release/windows","buildResources":"assets"},
    "files":["*.cjs","package.json"],"extraResources":[{"from":"../dist","to":"web"}],
    "publish":[{"provider":"generic","url":"https://github.com/OfficialSquidProductions/scenic-planner/releases/latest/download/"}],
    "win":{"target":"nsis","icon":"assets/icon.ico","artifactName":"Scenic-Windows-Setup.exe","verifyUpdateCodeSignature":false},
    "nsis":{"oneClick":true,"perMachine":false,"allowElevation":false,"createDesktopShortcut":true,"createStartMenuShortcut":true,"deleteAppDataOnUninstall":false,"runAfterFinish":false}
  }
}
